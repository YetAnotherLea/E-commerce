# Valeurs par défaut, sans secret. Les surcharges locales vont dans .env.local (ignoré par git).
# Voir README.md pour la configuration.

APP_ENV=dev
APP_SECRET=

# Adapter dans .env.local : DATABASE_URL="mysql://user:password@127.0.0.1:3306/ecommerce?serverVersion=11.8.6-MariaDB&charset=utf8mb4"
DATABASE_URL="mysql://app:app@127.0.0.1:3306/ecommerce?serverVersion=8.0&charset=utf8mb4"

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MAILER_DSN=null://null

# Origine du front en développement (Vite)
CORS_ALLOW_ORIGIN=http://localhost:5173

# Source du catalogue vêtements (surcharge du défaut de services.yaml)
# PRODUCTS_API_URL=https://dummyjson.com
